<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:keepScreenOn="true">

    <!-- Top Arabic text -->
    <TextView
        android:id="@+id/tvBismillah"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيم"
        android:textColor="@color/gold"
        android:textSize="20sp"
        android:fontFamily="serif"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TASBIH COUNTER"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:letterSpacing="0.25"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvBismillah"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Circular progress ring background -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressRing"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="24dp"
        app:trackThickness="8dp"
        app:indicatorColor="@color/green_primary"
        app:trackColor="@color/ring_track"
        app:indicatorSize="280dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Count display -->
    <TextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/text_primary"
        android:textSize="88sp"
        android:fontFamily="sans-serif-thin"
        android:textStyle="normal"
        app:layout_constraintTop_toTopOf="@id/progressRing"
        app:layout_constraintBottom_toBottomOf="@id/progressRing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.42" />

    <!-- Target display -->
    <TextView
        android:id="@+id/tvTarget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="/ 33"
        android:textColor="@color/text_muted"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/tvCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cycles (laps) counter -->
    <TextView
        android:id="@+id/tvCycles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/gold"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvTarget"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Milestone banner -->
    <TextView
        android:id="@+id/tvMilestone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مَاشَاءَاللَّٰه"
        android:textColor="@color/gold"
        android:textSize="22sp"
        android:fontFamily="serif"
        android:gravity="center"
        android:visibility="gone"
        android:background="@drawable/milestone_bg"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toBottomOf="@id/progressRing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Main COUNT button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCount"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:text="COUNT"
        android:textSize="18sp"
        android:letterSpacing="0.1"
        android:textColor="@color/text_primary"
        app:backgroundTint="@color/green_primary"
        app:cornerRadius="100dp"
        android:elevation="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/progressRing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/targetRow"
        app:layout_constraintVertical_bias="0.3" />

    <!-- Target preset row -->
    <LinearLayout
        android:id="@+id/targetRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn33"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="33"
            android:textColor="@color/text_muted"
            app:strokeColor="@color/ring_track"
            android:layout_marginHorizontal="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn99"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="99"
            android:textColor="@color/text_muted"
            app:strokeColor="@color/ring_track"
            android:layout_marginHorizontal="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn100"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="100"
            android:textColor="@color/text_muted"
            app:strokeColor="@color/ring_track"
            android:layout_marginHorizontal="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCustom"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Custom"
            android:textColor="@color/text_muted"
            app:strokeColor="@color/ring_track"
            android:layout_marginHorizontal="6dp" />

    </LinearLayout>

    <!-- Bottom row: Reset + Vibration -->
    <LinearLayout
        android:id="@+id/bottomRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↺ Reset"
            android:textColor="@color/text_muted"
            android:layout_marginEnd="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVibration"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📳 Vibration ON"
            android:textColor="@color/text_muted" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
